#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
[ "$branch" != main ] || exit 0
issue=$(printf '%s\n' "$branch" | sed -n 's|^[^/][^/]*/\([0-9][0-9]*\)-[^/][^/]*$|\1|p')
[ -n "$issue" ] || exit 0

if grep -Fx -e "Refs #$issue" -e "Closes #$issue" "$1" >/dev/null; then
    exit 0
else
    status=$?
    [ "$status" -eq 1 ] || exit "$status"
fi

printf '%s\n' \
    "branch-issue-reference: $branch 브랜치의 이슈 참조가 누락되었습니다." \
    "커밋 메시지의 독립된 줄에 Refs #$issue 또는 Closes #$issue 를 작성하세요." >&2
exit 1
