#!/bin/sh
set -eu

# main 커밋만 검사한다. 작업 브랜치와 detached HEAD는 생략한다.
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
[ "$branch" = main ] || exit 0

# 이름 변경을 삭제/추가로 검사하여 코드가 문서 경로로 이동해도 검증한다.
if git diff --cached --quiet --no-renames -- . \
    ':(exclude)docs/**' ':(exclude,glob)**/*.md'; then
    exit 0
else
    diff_status=$?
    [ "$diff_status" -eq 1 ] || exit "$diff_status"
fi

# Maven이 사용하는 JAVA_HOME을 우선하며, 없으면 PATH의 Java를 확인한다.
java_command=java
if [ -n "${JAVA_HOME:-}" ]; then
    java_command="$JAVA_HOME/bin/java"
fi
java_version=$("$java_command" -version 2>&1) || {
    printf '%s\n' "$java_version" >&2
    exit 1
}
case "$java_version" in
    *'version "1.8.'*) ;;
    *)
        printf '%s\n' 'pre-commit: JDK 8을 사용하도록 JAVA_HOME 또는 PATH를 설정하세요.' >&2
        exit 1
        ;;
esac

# 작업 파일을 그대로 검사한다. 미스테이징 변경도 포함될 수 있다.
printf '%s\n' 'pre-commit: mvn -B clean test'
exec mvn -B clean test
